# ---------------------------------------------------------------------------
# FluxPay — local configuration
# Copy to .env (native) or let docker compose interpolate these values.
# All defaults below are DEMO credentials. Rotate them for any shared deploy.
# ---------------------------------------------------------------------------
APP_ENV=demo
DEMO_MODE=true
# Convenience only: lets the local console auto-fill the demo key. Must be false
# in production (the app refuses to boot with APP_ENV=production if true).
DEMO_EXPOSE_API_KEY=true

HOST=0.0.0.0
PORT=8000

# Native default: ./data/gateway.db relative to the working directory.
# docker-compose overrides this to /app/data/gateway.db (named volume).
DATABASE_PATH=./data/gateway.db

# Merchant seed (stored hashed; the plaintext key is never persisted).
MERCHANT_ID=mch_demo
MERCHANT_NAME=Loja Demo
API_KEY=sk_demo_fluxpay_2026

# Webhook signing secret and the demo receiver URL (same process, loopback).
WEBHOOK_SECRET=whsec_demo_fluxpay_2026
WEBHOOK_URL=http://127.0.0.1:8000/demo/webhook-receiver?endpoint=whe_demo
WEBHOOK_TIMEOUT_SECONDS=10
# Five retries after the initial attempt: 10s, 30s, 2m, 10m, 1h.
WEBHOOK_MAX_ATTEMPTS=6
WEBHOOK_RETRY_SCHEDULE=10,30,120,600,3600
WEBHOOK_JITTER_RATIO=0.2
WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300

# PIX demo configuration.
PIX_KEY=demo@fluxpay.local
PIX_CITY=SAO PAULO
PIX_EXPIRES_MINUTES=30

# Simulated provider latency for cards (runs in the worker, never in the API).
CARD_AUTHORIZATION_DELAY_MS=350

# Durable worker + dispatcher threads.
WORKER_ENABLED=true
WORKER_POLL_SECONDS=0.25
DISPATCHER_POLL_SECONDS=0.5
QUEUE_BATCH_SIZE=10
QUEUE_MAX_ATTEMPTS=5

# --------------------------------------------------------------------------- #
# v0.3 — Event hub & realtime (WS /ws/events)
# EVENT_FANOUT: when true, every hub event enqueues its durable consumers
# (automation.evaluate, rag.index, crm.recompute_segments) in the same
# transaction (outbox pattern). Single-dashboard demos may set it false.
# --------------------------------------------------------------------------- #
EVENT_FANOUT=true
WS_ENABLED=true
WS_POLL_SECONDS=0.15          # app-level broadcast budget is <= 500 ms (RNF-10)
WS_HEARTBEAT_SECONDS=20       # server-ping every N seconds while idle
EVENT_STREAM_RETENTION_DAYS=30

# --------------------------------------------------------------------------- #
# v0.3 — Scheduled jobs (segments, RAG sweep, rollups, retention)
# JOBS_ENABLED unset follows WORKER_ENABLED.
# --------------------------------------------------------------------------- #
# JOBS_ENABLED=true
JOBS_SEGMENTS_SECONDS=60
JOBS_ANALYTICS_SECONDS=180
JOBS_RAG_SECONDS=300
JOBS_RETENTION_SECONDS=900
ANALYTICS_ROLLUP_DAYS=92

# --------------------------------------------------------------------------- #
# v0.3 — RAG (BM25 lexical search over the merchant's own data)
# RAG_SPECS_DIR points to the project specification documents that get indexed
# alongside payments, customers, automations and the event feed.
# --------------------------------------------------------------------------- #
RAG_ENABLED=true
# RAG_SPECS_DIR=../specs
RAG_INDEX_PAYMENTS_LIMIT=2000
RAG_INDEX_CUSTOMERS_LIMIT=2000
RAG_INDEX_FEED_DAYS=7

# --------------------------------------------------------------------------- #
# v0.3 — Assistant LLM (pluggable, OpenAI-compatible). Leave empty to run the
# deterministic local engine (templates + structured DB tools, <1.5 s).
# --------------------------------------------------------------------------- #
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
AGENT_LLM_TIMEOUT_SECONDS=30
AGENT_RATE_LIMIT_PER_MINUTE=30
AGENT_CONFIRM_TTL_SECONDS=600

# v0.3 — Privacy: mask e-mails in agent answers and logs when set.
PII_REDACT_EMAIL=0

LOG_LEVEL=INFO
